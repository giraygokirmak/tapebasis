#!/usr/bin/env bash
# Git's own copy of the quality gate for a push.
#
# A commit was already verified, but time passes between the two: a later edit,
# a rebase, a merge. The push is the moment the result becomes public, so the
# gate runs again, and this time it also mirrors docs/wiki into the wiki repo.
#
# Install once per clone:  git config core.hooksPath .githooks
#
# A ref deletion has nothing to verify, so it is not gated.
set -uo pipefail

verify=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [[ -n "${local_sha:-}" && "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
        verify=1
    fi
done

if (( verify == 0 )); then
    # No ref is being created or updated: nothing to verify.
    exit 0
fi

root="$(git rev-parse --show-toplevel)" || exit 1
exec "$root/scripts/quality-gate.sh" --push
