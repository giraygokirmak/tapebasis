# Keep credentials and local configuration out of the build context.
.env*
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*token*
*secret*
*credential*
secrets/
.secrets/

# Source-control and editor state is not needed in the image.
.git/
.github/
.gitignore
.dockerignore
.opencode/
.vscode/
.idea/

# The image installs a fresh environment instead of copying a host one.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
*.png.tmp
*.sqlite
*.sqlite3
*.db
build/
dist/
.tapebasis/

# Tests and documentation are installed neither as code nor as runtime data.
tests/
docs/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
site/
