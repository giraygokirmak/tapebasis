# =============================================================
# tapebasis, Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below (everything is optional)
# 3. .env is in .gitignore, it will NEVER be committed to git
#
# No proxy configuration: every provider talks to its upstream directly.
# =============================================================

# ── Server ───────────────────────────────────────────────────
# Only used by `tapebasis streamable-http`; the Docker CMD already sets these.
HOST=0.0.0.0
PORT=8000

# ── Provider health / schema-drift monitor ───────────────────
# The monitor probes every upstream endpoint (Finviz JSON islands + quote HTML,
# TradingView scanner + symbol search, Yahoo chart API for equity/FX/crypto,
# StockAnalysis quote API) and warns inside every tool response if a path, status
# code, JSON key or HTML marker changes. Bloomberg is deliberately not probed:
# its site gates plain HTTP clients on the TLS fingerprint.
TAPEBASIS_HEALTH_ENABLED=true
# How often to re-probe, in seconds.
TAPEBASIS_HEALTH_INTERVAL=300
# How long a cached verdict is reused before the next tool call re-probes.
TAPEBASIS_HEALTH_TTL=60
# Per-probe timeout, in seconds.
TAPEBASIS_HEALTH_TIMEOUT=12
# Where the schema baselines are stored, so drift is detected across restarts.
# Leave unset to use ~/.tapebasis/health_state.json.
# TAPEBASIS_HEALTH_STATE=/home/mcpuser/.tapebasis/state/health_state.json

# ── Per-provider pacing (every request to every provider) ────
# Hard floor between two request starts to one provider, in seconds.
TAPEBASIS_TV_MIN_INTERVAL=0.5
TAPEBASIS_FINVIZ_MIN_INTERVAL=0.35
# Yahoo answers 429 after a short burst.
TAPEBASIS_YAHOO_MIN_INTERVAL=1.0
# StockAnalysis fronts its API with Cloudflare and advertises a 3 s shared
# cache, so a normal pace is fine while a burst from one IP is still punished.
TAPEBASIS_SA_MIN_INTERVAL=0.5
# Bloomberg is paced slowest of all: its site gates plain HTTP clients on the
# TLS fingerprint (curl_cffi is required) and its API bucket burns fast.
TAPEBASIS_BLOOMBERG_MIN_INTERVAL=10.0
# Concurrent requests allowed per provider.
TAPEBASIS_TV_MAX_INFLIGHT=2
TAPEBASIS_FINVIZ_MAX_INFLIGHT=2
TAPEBASIS_YAHOO_MAX_INFLIGHT=1
TAPEBASIS_SA_MAX_INFLIGHT=2
TAPEBASIS_BLOOMBERG_MAX_INFLIGHT=1
# Retries per provider request (the shared cooldown is not tunable).
TAPEBASIS_TV_MAX_RETRIES=2
TAPEBASIS_FINVIZ_MAX_RETRIES=2
TAPEBASIS_YAHOO_MAX_RETRIES=2
TAPEBASIS_SA_MAX_RETRIES=2
TAPEBASIS_BLOOMBERG_MAX_RETRIES=1
# stockanalysis.com HTTP timeout and quote cache lifetime, in seconds.
TAPEBASIS_SA_TIMEOUT=20
TAPEBASIS_SA_CACHE_TTL=20
# Yahoo quote cache lifetime, in seconds. Absorbs the duplicate asks of one
# agent turn; Yahoo is the only leg that used to have no cache at all.
TAPEBASIS_YAHOO_CACHE_TTL=15
# Browser fingerprint curl_cffi presents to bloomberg.com. The newest `chrome`
# alias and `chrome131` are refused; `chrome124` and `firefox133` are accepted.
TAPEBASIS_BLOOMBERG_IMPERSONATE=chrome124
# bloomberg.com HTTP timeout and page cache lifetime, in seconds.
TAPEBASIS_BLOOMBERG_TIMEOUT=30
TAPEBASIS_BLOOMBERG_CACHE_TTL=60
# stock_prices limits for the Bloomberg leg: at most this many tickers per
# call, and a total time budget for the leg in seconds. Tickers the budget cuts
# off are named in `warnings`; the 10 s pacing itself is not relaxed.
TAPEBASIS_BLOOMBERG_BATCH_MAX=4
TAPEBASIS_BLOOMBERG_BATCH_BUDGET=12.0

# ── Finviz (scraper tuning) ──────────────────────────────────
# Cache lifetime for scraped pages, in seconds. Shorter = fresher quotes.
FINVIZ_CACHE_TTL=30
# HTTP timeout for finviz.com, in seconds.
FINVIZ_TIMEOUT=25
# Retries on transient failures inside the provider layer (Cloudflare
# interstitial, 5xx).
FINVIZ_MAX_RETRIES=2
# Where rendered chart PNGs are written.
# FINVIZ_CHART_DIR=/home/mcpuser/.tapebasis/charts

# ── TradingView provider layer (analysis services only) ──────
# These tune the technical-analysis and backtest services inside the provider
# package. The scanner, the chart websocket and every tool-level fan-out are
# paced by the TAPEBASIS_* limiters above.
TRADINGVIEW_MCP_MIN_INTERVAL_S=0.25
TRADINGVIEW_MCP_MAX_INFLIGHT=4
# Retry delays (comma-separated seconds) and jitter fraction.
TRADINGVIEW_MCP_RETRY_DELAYS=0.5,1.5,3.0
TRADINGVIEW_MCP_RETRY_JITTER=0.25

# ── News sentiment (optional, Marketaux) ────────────────────
# OPTIONAL. market_sentiment and combined_analysis work without it: when this
# is empty they score Finviz headlines locally (VADER + finance lexicon),
# deterministic, offline and free. Set the token to use Marketaux's licensed
# entity sentiment instead, which also adds article text + URLs to the news leg.
# Get a token at https://www.marketaux.com (free plan: 100 req/day).
MARKETAUX_API_TOKEN=
# Max Marketaux requests per day before serving cached/stub results.
MARKETAUX_DAILY_BUDGET=90
